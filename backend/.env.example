# Backend Environment Variables
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
PORT=5005
NODE_ENV=development
ADMIN_SECRET_TOKEN=change-this-to-a-strong-random-token
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Admin Credentials (for development; change in production)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-password-here

# Email settings for admin OTP deliveries
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="SuperNova Admin <your-email@gmail.com>"

# CORS Configuration (Production only; development defaults to localhost:3000 & 3001)
FRONTEND_URL=https://supernova.example.com
ADMIN_URL=https://admin.supernova.example.com

# Production Environment Variables
# Copy these to Render dashboard settings

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGODB_DB=ecommerce
USE_MONGO=true

# Payment Gateway (optional - using test keys for now)
RAZORPAY_KEY_ID=rzp_test_dummy_key
RAZORPAY_KEY_SECRET=test_dummy_secret

# Environment
NODE_ENV=production
PORT=10000

# Optional - AI Chatbot
OPENAI_API_KEY=sk-your_openai_key_here

# Server Settings
MIGRATE_MONGO_ON_START=false
ADMIN_SECRET_TOKEN=change-this-to-a-strong-random-token
